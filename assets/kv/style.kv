# =====================================================
# assets/kv/style.kv — Global Kivy styling for
# Khan'z Academy Mobile App (Premium Redesign)
# =====================================================

#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import MDApp kivymd.app.MDApp

# --------------------------------------------------
# Root screen background
# --------------------------------------------------

MDScreen:
    md_bg_color: app.theme_cls.bg_normal

# --------------------------------------------------
# MDTopAppBar overrides
# --------------------------------------------------

MDTopAppBar:
    md_bg_color: 0.247, 0.318, 0.710, 1  # Soft Indigo 500
    specific_text_color: 1, 1, 1, 1
    elevation: 2  # Softer shadow for a modern look

# --------------------------------------------------
# MDRaisedButton defaults
# --------------------------------------------------

MDRaisedButton:
    elevation: 1.5
    _radius: dp(12)  # More rounded premium buttons

# --------------------------------------------------
# MDTextField defaults
# --------------------------------------------------

MDTextField:
    mode: "rectangle"
    line_color_focus: 0.247, 0.318, 0.710, 1  # Soft Indigo 500
    hint_text_color_focus: 0.247, 0.318, 0.710, 1
    text_color_focus: 0.13, 0.13, 0.13, 1
    line_color_normal: 0.8, 0.8, 0.8, 1

# --------------------------------------------------
# MDCard defaults
# --------------------------------------------------

MDCard:
    radius: [dp(16), dp(16), dp(16), dp(16)]  # Generous rounded corners
    elevation: 1.5  # Soft elegant shadow
    md_bg_color: 1, 1, 1, 1

# --------------------------------------------------
# MDFlatButton
# --------------------------------------------------

MDFlatButton:
    _radius: dp(12)

# --------------------------------------------------
# MDDialog
# --------------------------------------------------

MDDialog:
    radius: [dp(16), dp(16), dp(16), dp(16)]
