/* =====================================================
   assets/kv/style.kv — Global Kivy styling for
   Khan'z Academy Mobile App
   ===================================================== */

#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import MDApp kivymd.app.MDApp

/* --------------------------------------------------
   Root screen background
   -------------------------------------------------- */

MDScreen:
    md_bg_color: app.theme_cls.bg_normal

/* --------------------------------------------------
   MDTopAppBar overrides
   -------------------------------------------------- */

MDTopAppBar:
    md_bg_color: 0.10, 0.14, 0.49, 1
    specific_text_color: 1, 1, 1, 1
    elevation: 4

/* --------------------------------------------------
   MDRaisedButton defaults
   -------------------------------------------------- */

MDRaisedButton:
    elevation: 2
    _radius: dp(8)

/* --------------------------------------------------
   MDTextField defaults
   -------------------------------------------------- */

MDTextField:
    mode: "rectangle"
    line_color_focus: 0.10, 0.14, 0.49, 1
    hint_text_color_focus: 0.10, 0.14, 0.49, 1
    text_color_focus: 0.13, 0.13, 0.13, 1

/* --------------------------------------------------
   MDCard defaults
   -------------------------------------------------- */

MDCard:
    radius: [dp(10), dp(10), dp(10), dp(10)]
    elevation: 1
    md_bg_color: 1, 1, 1, 1

/* --------------------------------------------------
   MDFlatButton
   -------------------------------------------------- */

MDFlatButton:
    _radius: dp(6)

/* --------------------------------------------------
   MDDialog
   -------------------------------------------------- */

MDDialog:
    radius: [dp(14), dp(14), dp(14), dp(14)]
